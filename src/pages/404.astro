---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
---

<Base title={`Página não encontrada · ${site.name}`}>
  <main class="nf sec--deep" id="conteudo-principal">
    <div class="wrap">
      <span class="muted" style="font-size: var(--t-xs); letter-spacing: 0.16em; text-transform: uppercase; font-weight: 600; display: block; margin-bottom: var(--s4);">
        Erro 404
      </span>
      <h1 class="h-xl">
        Página não encontrada
      </h1>
      <p class="muted">
        O endereço que você tentou acessar não existe ou foi alterado. Retorne para a página inicial para conhecer nossos procedimentos e agendar seu atendimento.
      </p>
      <div>
        <a href="/" class="btn btn--line">
          Voltar para a página inicial
        </a>
      </div>
    </div>
  </main>
</Base>
