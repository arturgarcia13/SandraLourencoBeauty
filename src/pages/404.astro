---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
---

<Base title="Página não encontrada — Sandra Lourenço Beauty">
  <main class="min-h-screen bg-ink text-ivory flex flex-col items-center justify-center p-6 text-center">
    <div class="max-w-md mx-auto">
      <span class="w-12 h-12 rounded-full border border-champagne/40 bg-champagne/10 flex items-center justify-center text-champagne mx-auto mb-4 font-serif text-lg">
        ✦
      </span>
      <h1 class="font-serif text-5xl sm:text-6xl font-medium tracking-tight mb-4">
        404
      </h1>
      <h2 class="font-serif text-2xl font-medium text-champagne mb-3">
        Página não encontrada
      </h2>
      <p class="font-sans text-sm text-ivory/70 leading-relaxed mb-8">
        O endereço que você tentou acessar não existe ou foi alterado. Retorne para a página inicial ou fale conosco pelo WhatsApp.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <Button href="/" variant="outline-dark" size="md">
          Voltar para a página inicial
        </Button>
      </div>
    </div>
  </main>
</Base>
