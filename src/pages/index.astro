---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Pillars from '../components/Pillars.astro';
import TaglineReveal from '../components/TaglineReveal.astro';
import FeaturedProcedures from '../components/FeaturedProcedures.astro';
import ServiceMenu from '../components/ServiceMenu.astro';
import Founder from '../components/Founder.astro';
import Transformations from '../components/Transformations.astro';
import Protocol from '../components/Protocol.astro';
import Policies from '../components/Policies.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import Location from '../components/Location.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
---

<Base>
  <Header />
  
  <main id="conteudo-principal">
    <Hero />
    <Pillars />
    <TaglineReveal />
    <FeaturedProcedures />
    <ServiceMenu />
    <Founder />
    <Transformations />
    <Protocol />
    <Policies />
    <Testimonials />
    <Faq />
    <Location />
    <FinalCta />
  </main>

  <Footer />
  <WhatsAppFab />
</Base>
