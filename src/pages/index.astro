---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Tagline from '../components/Tagline.astro';
import Results from '../components/Results.astro';
import Services from '../components/Services.astro';
import Method from '../components/Method.astro';
import Space from '../components/Space.astro';
import Reviews from '../components/Reviews.astro';
import FaqLocation from '../components/FaqLocation.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
---

<Base>
  <Header />

  <main id="conteudo-principal">
    <Hero />
    <Tagline />
    <Results />
    <Services />
    <Method />
    <Space />
    <Reviews />
    <FaqLocation />
    <FinalCta />
  </main>

  <Footer />
  <WhatsAppFab />
</Base>
