---
import Badge from './ui/Badge.astro';
import Icon from './ui/Icon.astro';
import { waServiceLink } from '../lib/whatsapp';
import type { EnrichedService } from '../lib/services';

interface Props {
  service: EnrichedService;
  isCompact?: boolean;
}

const { service, isCompact = false } = Astro.props;
const whatsappUrl = waServiceLink(service.name);
---

<div class={`group py-4 px-4 rounded-lg transition-colors duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:bg-sand/20 border-b hairline last:border-b-0 flex items-start sm:items-center justify-between gap-3 ${isCompact ? 'text-xs' : ''}`}>
  <div class="flex-1 min-w-0 pr-2">
    <div class="flex flex-wrap items-center gap-2 mb-1">
      <h4 class="font-serif text-lg sm:text-xl font-medium tracking-tight text-ink group-hover:text-bronze transition-colors">
        {service.name}
      </h4>

      {service.hasFormol && (
        <Badge variant="formol">
          Fórmula com formol
        </Badge>
      )}

      {service.isOrganica && (
        <Badge variant="leaf">
          Livre de formol
        </Badge>
      )}
    </div>

    {service.description && !isCompact && (
      <p class="text-xs font-sans text-olive line-clamp-2 leading-relaxed mb-2 text-pretty">
        {service.description}
      </p>
    )}

    <div class="flex items-center gap-3 text-xs font-sans text-olive">
      <span class="inline-flex items-center gap-1">
        <Icon name="clock-light" size={14} />
        {service.durationFormatted}
      </span>
      <span class="w-1 h-1 rounded-full bg-olive/40"></span>
      <span class="font-semibold text-ink">
        {service.priceFormatted}
      </span>
    </div>
  </div>

  <!-- Ação Rápida WhatsApp (Touch target >= 48px) -->
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Consultar ${service.name} no WhatsApp`}
    class="shrink-0 inline-flex items-center justify-center w-12 h-12 min-w-[48px] min-h-[48px] rounded-lg bg-wa/10 text-[#128C7E] hover:bg-wa hover:text-white border border-wa/30 transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-wa"
  >
    <Icon name="whatsapp-logo" size={20} />
  </a>
</div>
