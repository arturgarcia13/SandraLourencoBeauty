---
import { getImage } from '../lib/media';
interface Props { name: string; alt: string; sizes?: string; eager?: boolean; class?: string }
const { name, alt, sizes = '(min-width: 900px) 40vw, 100vw', eager = false, class: cls = '' } = Astro.props;
const img = getImage(name);
const set = (ext: string) => img?.sizes.map((w) => `/m/${name}-${w}.${ext} ${w}w`).join(', ');
const largest = img ? img.sizes[img.sizes.length - 1] : 0;
---
{img && (
  <picture class={cls}>
    <source type="image/avif" srcset={set('avif')} sizes={sizes} />
    <source type="image/webp" srcset={set('webp')} sizes={sizes} />
    <img
      src={`/m/${name}-${largest}.webp`}
      srcset={set('webp')}
      sizes={sizes}
      width={img.width}
      height={img.height}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={eager ? 'high' : undefined}
    />
  </picture>
)}
