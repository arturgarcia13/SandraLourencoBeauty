---
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
import { site } from '../config/site';
import { waLink } from '../lib/whatsapp';
---

<header class="fixed top-0 left-0 right-0 z-50 px-4 pointer-events-none">
  <div class="mt-4 sm:mt-6 mx-auto max-w-4xl w-full rounded-full bg-ink/85 backdrop-blur-xl border border-white/10 px-4 sm:px-6 py-2 flex items-center justify-between shadow-2xl pointer-events-auto transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)]">
    
    <!-- Brand Wordmark + Logo -->
    <a href="/" aria-label="Sandra Lourenço Beauty — Início" class="flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-champagne rounded-full pr-2 min-h-[48px]">
      <div class="w-8 h-8 rounded-full overflow-hidden border border-white/20 bg-charcoal shrink-0">
        <img
          src="/logo.jpg"
          alt={site.name}
          class="w-full h-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:scale-105"
          width="32"
          height="32"
        />
      </div>

      <div class="flex flex-col">
        <span class="font-serif text-base sm:text-lg font-medium tracking-tight text-ivory leading-none group-hover:text-champagne transition-colors duration-700 ease-[cubic-bezier(0.32,0.72,0,1)]">
          Sandra Lourenço
        </span>
        <span class="font-sans text-xs tracking-widest uppercase text-champagne font-semibold mt-0.5">
          Beauty
        </span>
      </div>
    </a>

    <!-- Links de Navegação Discretos (Desktop) -->
    <nav aria-label="Navegação principal" id="desktop-nav" class="hidden md:flex items-center gap-6 text-xs font-sans text-ivory/70">
      <a href="/#procedimentos" data-section="procedimentos" class="desktop-nav-link py-2 hover:text-champagne transition-colors duration-700 ease-[cubic-bezier(0.32,0.72,0,1)]">Especialidades</a>
      <a href="/#menu-servicos" data-section="menu-servicos" class="desktop-nav-link py-2 hover:text-champagne transition-colors duration-700 ease-[cubic-bezier(0.32,0.72,0,1)]">Serviços</a>
      <a href="/#transformacoes" data-section="transformacoes" class="desktop-nav-link py-2 hover:text-champagne transition-colors duration-700 ease-[cubic-bezier(0.32,0.72,0,1)]">Resultados</a>
      <a href="/#localizacao" data-section="localizacao" class="desktop-nav-link py-2 hover:text-champagne transition-colors duration-700 ease-[cubic-bezier(0.32,0.72,0,1)]">Localização</a>
    </nav>

    <!-- Quick CTA & Hamburger Mobile (Touch target >= 48px) -->
    <div class="flex items-center gap-2">
      <Button
        href={waLink('Gostaria de consultar disponibilidade na agenda.')}
        target="_blank"
        rel="noopener noreferrer"
        variant="wa"
        size="sm"
        class="text-xs font-semibold"
      >
        <Icon name="whatsapp-logo" size={16} class="mr-1" />
        <span>Agendar</span>
      </Button>

      <!-- Botão Hambúrguer com Morfologia Fluida (Regra B7) -->
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label="Abrir menu de navegação"
        aria-expanded="false"
        aria-controls="mobile-nav-modal"
        class="md:hidden w-12 h-12 flex flex-col items-center justify-center gap-1.5 rounded-full text-ivory hover:text-champagne focus:outline-none focus-visible:ring-2 focus-visible:ring-champagne active:scale-[0.98] transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] relative z-50 cursor-pointer"
      >
        <span id="hamb-line-1" class="w-5 h-0.5 bg-current rounded-full transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] transform origin-center"></span>
        <span id="hamb-line-2" class="w-5 h-0.5 bg-current rounded-full transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] transform origin-center"></span>
        <span id="hamb-line-3" class="w-5 h-0.5 bg-current rounded-full transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] transform origin-center"></span>
      </button>
    </div>

  </div>
</header>

<!-- Expansão Modal com Vidro Profundo e Revelação Escalonada (Regra B7) -->
<div
  id="mobile-nav-modal"
  role="dialog"
  aria-modal="true"
  aria-label="Menu de navegação"
  class="md:hidden fixed inset-0 z-40 bg-ink/90 backdrop-blur-3xl flex flex-col justify-between p-6 pt-28 pb-[max(2.5rem,env(safe-area-inset-bottom,2.5rem))] transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] opacity-0 pointer-events-none data-[open=true]:opacity-100 data-[open=true]:pointer-events-auto"
>
  <nav class="flex flex-col space-y-4 max-w-sm mx-auto w-full text-center">
    <a
      href="/#procedimentos"
      class="mobile-nav-link text-2xl font-serif text-ivory hover:text-champagne transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] py-2 translate-y-12 opacity-0 delay-100"
    >
      Especialidades
    </a>
    <a
      href="/#menu-servicos"
      class="mobile-nav-link text-2xl font-serif text-ivory hover:text-champagne transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] py-2 translate-y-12 opacity-0 delay-150"
    >
      Tabela de procedimentos
    </a>
    <a
      href="/#transformacoes"
      class="mobile-nav-link text-2xl font-serif text-ivory hover:text-champagne transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] py-2 translate-y-12 opacity-0 delay-200"
    >
      Resultados e transformações
    </a>
    <a
      href="/#protocolo"
      class="mobile-nav-link text-2xl font-serif text-ivory hover:text-champagne transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] py-2 translate-y-12 opacity-0 delay-250"
    >
      Protocolo de biossegurança
    </a>
    <a
      href="/#faq"
      class="mobile-nav-link text-2xl font-serif text-ivory hover:text-champagne transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] py-2 translate-y-12 opacity-0 delay-300"
    >
      Perguntas frequentes
    </a>
    <a
      href="/#localizacao"
      class="mobile-nav-link text-2xl font-serif text-ivory hover:text-champagne transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] py-2 translate-y-12 opacity-0 delay-350"
    >
      Como chegar ao estúdio
    </a>
  </nav>

  <div class="max-w-sm mx-auto w-full pt-6 border-t hairline-dark text-center space-y-4">
    <Button
      href={waLink('Olá! Gostaria de consultar horários disponíveis na agenda.')}
      target="_blank"
      rel="noopener noreferrer"
      variant="wa"
      size="lg"
      fullWidth={true}
    >
      <Icon name="whatsapp-logo" size={20} class="mr-2" />
      <span>Consultar no WhatsApp</span>
    </Button>

    <p class="text-xs font-sans text-ivory/60">
      {site.address.street}, {site.address.district} · Fortaleza/CE
    </p>
  </div>
</div>

<script>
  (function () {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const modal = document.getElementById('mobile-nav-modal');
    const line1 = document.getElementById('hamb-line-1');
    const line2 = document.getElementById('hamb-line-2');
    const line3 = document.getElementById('hamb-line-3');
    const links = modal?.querySelectorAll<HTMLElement>('.mobile-nav-link');
    const desktopLinks = document.querySelectorAll<HTMLElement>('.desktop-nav-link');

    if (!toggleBtn || !modal || !line1 || !line2 || !line3) return;

    let isOpen = false;

    function setMenuState(open: boolean) {
      isOpen = open;
      toggleBtn?.setAttribute('aria-expanded', String(isOpen));
      toggleBtn?.setAttribute('aria-label', isOpen ? 'Fechar menu de navegação' : 'Abrir menu de navegação');
      
      if (isOpen) {
        modal?.setAttribute('data-open', 'true');
        document.body.style.overflow = 'hidden';

        // Hamburger morph para X
        line1?.classList.add('translate-y-2', 'rotate-45');
        line2?.classList.add('opacity-0', '-translate-x-2');
        line3?.classList.add('-translate-y-2', '-rotate-45');

        // Escalonamento suave dos links
        links?.forEach((link) => {
          link.classList.remove('translate-y-12', 'opacity-0');
          link.classList.add('translate-y-0', 'opacity-100');
        });

        // Foco inicial acessível
        const firstLink = links?.[0];
        if (firstLink) firstLink.focus();
      } else {
        modal?.removeAttribute('data-open');
        document.body.style.overflow = '';

        // Retorno fluido das linhas do hambúrguer
        line1?.classList.remove('translate-y-2', 'rotate-45');
        line2?.classList.remove('opacity-0', '-translate-x-2');
        line3?.classList.remove('-translate-y-2', '-rotate-45');

        // Reset dos links
        links?.forEach((link) => {
          link.classList.add('translate-y-12', 'opacity-0');
          link.classList.remove('translate-y-0', 'opacity-100');
        });

        toggleBtn?.focus();
      }
    }

    toggleBtn.addEventListener('click', () => {
      setMenuState(!isOpen);
    });

    links?.forEach((link) => {
      link.addEventListener('click', () => {
        setMenuState(false);
      });
    });

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        setMenuState(false);
      }
    });

    modal.addEventListener('keydown', (e) => {
      if (e.key === 'Tab' && isOpen) {
        const focusable = modal.querySelectorAll<HTMLElement>('a, button');
        if (!focusable.length) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        setMenuState(false);
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768 && isOpen) {
        setMenuState(false);
      }
    });

    // Indicador da seção ativa no desktop (Regra B9)
    if (desktopLinks.length && 'IntersectionObserver' in window) {
      const sectionIds = ['procedimentos', 'menu-servicos', 'transformacoes', 'localizacao'];
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const currentId = entry.target.id;
              desktopLinks.forEach((link) => {
                const isActive = link.getAttribute('data-section') === currentId;
                if (isActive) {
                  link.classList.add('text-champagne', 'font-semibold');
                  link.classList.remove('text-ivory/70');
                  link.setAttribute('aria-current', 'location');
                } else {
                  link.classList.remove('text-champagne', 'font-semibold');
                  link.classList.add('text-ivory/70');
                  link.removeAttribute('aria-current');
                }
              });
            }
          });
        },
        { rootMargin: '-20% 0px -70% 0px' }
      );

      sectionIds.forEach((id) => {
        const el = document.getElementById(id);
        if (el) observer.observe(el);
      });
    }
  })();
</script>
