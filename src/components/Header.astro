---
import { site } from '../config/site';
import { waLink } from '../lib/whatsapp';

const headerWaLink = waLink('Gostaria de agendar um atendimento.');

const navItems = [
  { href: '#servicos', label: 'Serviços', index: '01' },
  { href: '#metodo', label: 'Método', index: '02' },
  { href: '#espaco', label: 'O Espaço', index: '03' },
  { href: '#avaliacoes', label: 'Avaliações', index: '04' },
  { href: '#faq', label: 'Dúvidas', index: '05' },
];
---

<header class="hdr" data-header>
  <div class="wrap hdr__bar">
    <a href="/" class="brand" aria-label={`${site.name}. Página inicial`}>
      <span class="brand__logo" aria-hidden="true"></span>
      <span>
        Sandra Lourenço
        <small>Beauty</small>
      </span>
    </a>

    <button
      type="button"
      class="menu-btn"
      aria-expanded="false"
      aria-controls="menu-principal"
      aria-label="Abrir menu de navegação"
      data-menu-btn
    >
      <span class="menu-btn__label" data-menu-label>Menu</span>
      <span class="menu-btn__lines" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
    </button>
  </div>

  <div class="menu" id="menu-principal" aria-hidden="true" data-menu>
    <div class="menu__inner">
      <nav class="menu__nav" aria-label="Navegação principal">
        {navItems.map((item) => (
          <a href={item.href} class="menu__link" data-menu-link>
            <span class="menu__index" aria-hidden="true">{item.index}</span>
            <span class="menu__word">{item.label}</span>
          </a>
        ))}
      </nav>

      <div class="menu__foot">
        <a
          href={headerWaLink}
          class="btn btn--accent btn--block"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Agendar atendimento pelo WhatsApp"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
          </svg>
          <span>Agendar no WhatsApp</span>
        </a>
        <p class="menu__note">Atendimento privativo com hora marcada, segunda a sexta, das 09h às 16h30.</p>
      </div>
    </div>
  </div>
</header>
