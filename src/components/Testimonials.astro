---
import SectionHeading from './ui/SectionHeading.astro';
import Icon from './ui/Icon.astro';
import { site } from '../config/site';

const reviews = [
  {
    name: 'Mariana Vasconcelos',
    role: 'Cliente de mechas e loiro saudável',
    comment: 'Eu tinha muito receio de clarear porque meu cabelo já tinha sofrido corte químico em outro lugar. A Sandra fez o teste de mechas com toda paciência e o resultado ficou maravilhoso. Loiro claríssimo e meu cabelo continua forte e macio.',
    rating: 5,
  },
  {
    name: 'Camila Albuquerque',
    role: 'Cliente de escova orgânica',
    comment: 'Fiz a Escova Orgânica enquanto amamentava e foi perfeito. Zero cheiro forte, zero fumaça e o cabelo ficou com um brilho espelhado que dura meses. O atendimento sem acompanhantes faz o salão ser muito calmo e seguro.',
    rating: 5,
  },
  {
    name: 'Juliana Siqueira',
    role: 'Cliente de morena iluminada',
    comment: 'A Sandra tem uma precisão técnica admirável. Ela estudou o tom da minha pele e fez uma morena iluminada caramelo impecável. Dá para sentir o cuidado com a esterilização e com a pontualidade do horário.',
    rating: 5,
  },
];
---

<section id="depoimentos" class="py-16 sm:py-24 bg-ivory border-b hairline">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <SectionHeading
      eyebrow="Prova social comprovada"
      title="A satisfação de quem confia em nossas mãos"
      description="Mais de 40 avaliações de 5 estrelas atestam a qualidade, o acolhimento e a excelência técnica de Sandra Lourenço."
      align="center"
      class="mb-12 sm:mb-16"
    />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {reviews.map((rev) => (
        <div class="bg-white rounded-xl p-6 sm:p-8 border hairline shadow-sm flex flex-col justify-between hover:shadow-lg transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)]">
          <div>
            <!-- Estrelas e Aspas -->
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-1 text-champagne">
                {Array.from({ length: rev.rating }).map(() => (
                  <Icon name="star-fill" size={16} />
                ))}
              </div>
              <span class="font-serif text-3xl leading-none text-champagne/40">
                “
              </span>
            </div>

            <!-- Sem itálico per B1 -->
            <p class="font-sans text-xs sm:text-sm text-olive leading-relaxed mb-6 not-italic text-pretty">
              "{rev.comment}"
            </p>
          </div>

          <div class="pt-4 border-t hairline flex flex-col">
            <span class="font-serif text-xl font-medium text-ink">
              {rev.name}
            </span>
            <span class="text-xs font-sans text-champagne font-medium uppercase tracking-wider mt-1">
              {rev.role}
            </span>
          </div>
        </div>
      ))}
    </div>

    <!-- Badge Central de Avaliações -->
    <div class="mt-12 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-sand/30 border hairline text-xs font-sans text-olive">
        <Icon name="star-fill" size={14} class="text-champagne" />
        <span class="font-semibold text-ink">{site.rating.value} de 5.0 estrelas</span>
        <span>•</span>
        <span>Avaliado por {site.rating.count} clientes no {site.rating.source}</span>
      </div>
    </div>
  </div>
</section>
