---
import Icon from './ui/Icon.astro';
import { site } from '../config/site';
import { waLink } from '../lib/whatsapp';

interface Props {
  id?: string;
  dark?: boolean;
}

const {
  id = 'quick-scheduler',
  dark = true,
} = Astro.props;

const defaultProcedure = 'Loiro e Mechas';
const defaultPeriod = 'Manhã';
const defaultLink = waLink(`Gostaria de consultar disponibilidade para *${defaultProcedure}*, de preferência no período da *${defaultPeriod}*.`);

const procedures = [
  { id: 'loiro', label: 'Loiro e Mechas' },
  { id: 'morena', label: 'Morena Iluminada' },
  { id: 'organica', label: 'Escova Orgânica sem formol' },
  { id: 'light', label: 'Alisamento Light' },
  { id: 'cor', label: 'Cor e Tonalização' },
  { id: 'tratamento', label: 'Corte ou Tratamento' },
];

const periods = site.hours.periods;
---

<div
  id={id}
  class={`w-full rounded-xl p-4 sm:p-6 border transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] ${dark ? 'bg-charcoal border-white/10 shadow-2xl' : 'bg-white border-sand shadow-sm'}`}
>
  <div class="mb-4">
    <div class="flex items-center justify-between">
      <span class="text-xs font-sans font-semibold tracking-wider uppercase text-champagne">
        Escolha seu atendimento
      </span>
      <span class={`text-xs font-sans ${dark ? 'text-ivory/80' : 'text-olive'}`}>
        Direto no WhatsApp
      </span>
    </div>
    <p class={`text-sm font-medium mt-1 ${dark ? 'text-ivory' : 'text-ink'}`}>
      Selecione o procedimento e o período de sua preferência:
    </p>
  </div>

  <!-- Etapa 1: Procedimento -->
  <div class="mb-4">
    <label class={`block text-xs font-sans mb-2 font-medium ${dark ? 'text-ivory/80' : 'text-olive'}`}>
      1. Procedimento desejado
    </label>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2" role="radiogroup" aria-label="Procedimento desejado">
      {procedures.map((proc, index) => (
        <button
          type="button"
          role="radio"
          aria-checked={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
          data-type="procedure"
          data-value={proc.label}
          class={`procedure-chip min-h-[48px] text-left text-xs font-sans font-medium p-3 rounded-lg border transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-champagne cursor-pointer flex items-center ${index === 0 ? 'bg-champagne text-ink border-champagne font-semibold' : dark ? 'bg-ink/50 text-ivory/80 border-white/10 hover:border-champagne/40' : 'bg-ivory text-ink/80 border-sand hover:border-champagne/60'}`}
        >
          <span>{proc.label}</span>
        </button>
      ))}
    </div>
  </div>

  <!-- Etapa 2: Período -->
  <div class="mb-6">
    <label class={`block text-xs font-sans mb-2 font-medium ${dark ? 'text-ivory/80' : 'text-olive'}`}>
      2. Período preferencial
    </label>
    <div class="grid grid-cols-2 gap-2" role="radiogroup" aria-label="Período preferencial">
      {periods.map((p, index) => (
        <button
          type="button"
          role="radio"
          aria-checked={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
          data-type="period"
          data-value={p.label}
          class={`period-chip min-h-[48px] text-left text-xs font-sans font-medium p-3 rounded-lg border transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-champagne flex items-center justify-between cursor-pointer ${index === 0 ? 'bg-champagne text-ink border-champagne font-semibold' : dark ? 'bg-ink/50 text-ivory/80 border-white/10 hover:border-champagne/40' : 'bg-ivory text-ink/80 border-sand hover:border-champagne/60'}`}
        >
          <span>{p.label}</span>
          <span class="text-xs opacity-75">{p.range}</span>
        </button>
      ))}
    </div>
  </div>

  <!-- Botão de Ação (Touch target >= 48px) -->
  <a
    id={`${id}-submit-btn`}
    href={defaultLink}
    target="_blank"
    rel="noopener noreferrer"
    class="w-full min-h-[48px] inline-flex items-center justify-center font-sans font-semibold text-base py-3 px-4 rounded-lg bg-wa text-white hover:bg-wa-hover shadow-md hover:shadow-lg transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] gap-2 active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-wa focus-visible:ring-offset-2"
  >
    <Icon name="whatsapp-logo" size={20} />
    <span id={`${id}-btn-label`}>
      Consultar horário no WhatsApp
    </span>
  </a>

  <p class={`text-xs text-center mt-3 text-pretty ${dark ? 'text-ivory/75' : 'text-olive/80'}`}>
    Atendimento com hora marcada a cada 30 minutos em dias úteis das 09h às 16h30
  </p>
</div>

<script define:vars={{ id, isDark: dark, whatsappNumber: site.whatsapp.number, greeting: site.whatsapp.greeting }}>
  (function () {
    const container = document.getElementById(id);
    if (!container) return;

    let selectedProcedure = 'Loiro e Mechas';
    let selectedPeriod = 'Manhã';

    const procedureChips = Array.from(container.querySelectorAll('.procedure-chip'));
    const periodChips = Array.from(container.querySelectorAll('.period-chip'));
    const submitBtn = document.getElementById(`${id}-submit-btn`);
    const btnLabel = document.getElementById(`${id}-btn-label`);

    const unselectedClasses = isDark
      ? ['bg-ink/50', 'text-ivory/80', 'border-white/10']
      : ['bg-ivory', 'text-ink/80', 'border-sand'];

    function updateUrl() {
      const msg = `${greeting} Gostaria de consultar disponibilidade para *${selectedProcedure}*, de preferência no período da *${selectedPeriod}*.`;
      const url = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(msg)}`;
      if (submitBtn) {
        submitBtn.setAttribute('href', url);
      }
      if (btnLabel) {
        btnLabel.textContent = `Consultar ${selectedProcedure} (${selectedPeriod})`;
      }
    }

    function selectProcedure(chip) {
      procedureChips.forEach((c) => {
        c.setAttribute('aria-checked', 'false');
        c.setAttribute('tabindex', '-1');
        c.classList.remove('bg-champagne', 'text-ink', 'border-champagne', 'font-semibold');
        c.classList.add(...unselectedClasses);
      });
      chip.setAttribute('aria-checked', 'true');
      chip.setAttribute('tabindex', '0');
      chip.classList.add('bg-champagne', 'text-ink', 'border-champagne', 'font-semibold');
      chip.classList.remove(...unselectedClasses);
      selectedProcedure = chip.getAttribute('data-value') || selectedProcedure;
      updateUrl();
    }

    function selectPeriod(chip) {
      periodChips.forEach((c) => {
        c.setAttribute('aria-checked', 'false');
        c.setAttribute('tabindex', '-1');
        c.classList.remove('bg-champagne', 'text-ink', 'border-champagne', 'font-semibold');
        c.classList.add(...unselectedClasses);
      });
      chip.setAttribute('aria-checked', 'true');
      chip.setAttribute('tabindex', '0');
      chip.classList.add('bg-champagne', 'text-ink', 'border-champagne', 'font-semibold');
      chip.classList.remove(...unselectedClasses);
      selectedPeriod = chip.getAttribute('data-value') || selectedPeriod;
      updateUrl();
    }

    procedureChips.forEach((chip, idx) => {
      chip.addEventListener('click', () => selectProcedure(chip));
      chip.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          const next = procedureChips[(idx + 1) % procedureChips.length];
          next.focus();
          selectProcedure(next);
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          const prev = procedureChips[(idx - 1 + procedureChips.length) % procedureChips.length];
          prev.focus();
          selectProcedure(prev);
        }
      });
    });

    periodChips.forEach((chip, idx) => {
      chip.addEventListener('click', () => selectPeriod(chip));
      chip.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          const next = periodChips[(idx + 1) % periodChips.length];
          next.focus();
          selectPeriod(next);
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          const prev = periodChips[(idx - 1 + periodChips.length) % periodChips.length];
          prev.focus();
          selectPeriod(prev);
        }
      });
    });
  })();
</script>
