---
interface Props {
  aspectRatio?: '4/5' | '9/16' | '1/1' | '16/9';
  label?: string;
  sublabel?: string;
  dark?: boolean;
  class?: string;
  imageSrc?: string;
  alt?: string;
}

const {
  aspectRatio = '4/5',
  label = 'Acervo Sandra Lourenço',
  sublabel = 'Foto autoral em luz profissional',
  dark = true,
  class: className = '',
  imageSrc,
  alt = 'Fotografia profissional Sandra Lourenço Beauty',
} = Astro.props;

const aspectClasses = {
  '4/5': 'aspect-[4/5]',
  '9/16': 'aspect-[9/16]',
  '1/1': 'aspect-square',
  '16/9': 'aspect-video',
};
---

<div
  class={`relative overflow-hidden rounded-lg w-full ${aspectClasses[aspectRatio]} flex items-center justify-center border transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group ${dark ? 'bg-charcoal border-white/10' : 'bg-white border-sand'} ${className}`}
>
  {imageSrc ? (
    <img
      src={imageSrc}
      alt={alt}
      class="w-full h-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:scale-105"
      loading="lazy"
    />
  ) : (
    <>
      <!-- Moldura sutil interna -->
      <div class="absolute inset-3 border hairline-dark/40 rounded-md pointer-events-none flex flex-col justify-between p-3">
        <div class="flex justify-between items-start">
          <span class="w-2 h-2 border-t border-l border-champagne/40"></span>
          <span class="w-2 h-2 border-t border-r border-champagne/40"></span>
        </div>
        <div class="flex justify-between items-end">
          <span class="w-2 h-2 border-b border-l border-champagne/40"></span>
          <span class="w-2 h-2 border-b border-r border-champagne/40"></span>
        </div>
      </div>

      <!-- Conteúdo central (Sem itálico per B1) -->
      <div class="relative z-10 text-center px-6 py-4 flex flex-col items-center">
        <!-- Monograma estilizado sem itálico -->
        <div class="w-10 h-10 rounded-full border border-champagne/40 flex items-center justify-center mb-3 bg-champagne/10">
          <span class="font-serif not-italic text-champagne text-sm font-semibold tracking-wider">SL</span>
        </div>

        <p class={`font-serif text-lg tracking-wide font-medium ${dark ? 'text-ivory' : 'text-ink'}`}>
          {label}
        </p>

        {sublabel && (
          <p class={`text-xs font-sans tracking-wider uppercase mt-1 ${dark ? 'text-champagne-light/70' : 'text-olive'}`}>
            {sublabel}
          </p>
        )}

        <div class="mt-3 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-black/60 border border-white/10 text-xs text-ivory/60 tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-champagne animate-pulse"></span>
          100% autoral
        </div>
      </div>
    </>
  )}
</div>
