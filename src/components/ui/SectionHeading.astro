---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  dark?: boolean;
  align?: 'center' | 'left';
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  dark = false,
  align = 'center',
  class: className = '',
} = Astro.props;

const alignClasses = align === 'center' ? 'text-center mx-auto items-center' : 'text-left items-start';
---

<div class={`flex flex-col max-w-[680px] ${alignClasses} ${className}`}>
  {eyebrow && (
    <span class={`inline-block text-xs font-sans font-medium tracking-widest uppercase mb-2 ${dark ? 'text-champagne' : 'text-olive'}`}>
      {eyebrow}
    </span>
  )}

  <h2 class={`text-3xl sm:text-4xl lg:text-5xl leading-tight font-serif font-medium tracking-tight mb-4 text-balance ${dark ? 'text-ivory' : 'text-ink'}`}>
    {title}
  </h2>

  {description && (
    <p class={`text-sm sm:text-base leading-relaxed font-sans font-normal text-pretty ${dark ? 'text-ivory/70' : 'text-olive'} max-w-xl`}>
      {description}
    </p>
  )}

  <div class="mt-4 flex items-center justify-center gap-2 opacity-60">
    <span class="w-8 h-[1px] bg-champagne"></span>
    <span class="w-1.5 h-1.5 rotate-45 border border-champagne"></span>
    <span class="w-8 h-[1px] bg-champagne"></span>
  </div>
</div>
