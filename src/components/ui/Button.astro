---
interface Props {
  href?: string;
  variant?: 'wa' | 'gold' | 'dark' | 'outline' | 'outline-dark' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  fullWidth?: boolean;
  class?: string;
  target?: string;
  rel?: string;
  type?: 'button' | 'submit' | 'reset';
  'data-track'?: string;
  id?: string;
}

const {
  href,
  variant = 'wa',
  size = 'md',
  fullWidth = false,
  class: className = '',
  target,
  rel,
  type = 'button',
  id,
  ...rest
} = Astro.props;

// Regras de botão da skill landing-page-design:
// Main buttons: text-base, semibold, py-2 px-3 (8px x 12px)
// Smaller header buttons: text-sm, semibold, py-2 px-3
// Transição customizada ease-[cubic-bezier(0.32,0.72,0,1)]
const baseStyles = 'inline-flex items-center justify-center font-sans font-semibold transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] select-none active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-champagne focus-visible:ring-offset-2 rounded-lg';

const variants = {
  wa: 'bg-wa text-white hover:bg-wa-hover shadow-sm hover:shadow',
  gold: 'bg-champagne text-ink hover:bg-champagne-light shadow-sm hover:shadow',
  dark: 'bg-ink text-ivory hover:bg-charcoal border border-white/10',
  outline: 'bg-transparent text-ink border border-ink/20 hover:border-ink hover:bg-ink/5',
  'outline-dark': 'bg-transparent text-ivory border border-white/20 hover:border-white/50 hover:bg-white/5',
  ghost: 'bg-transparent text-ink hover:bg-black/5',
};

const sizes = {
  sm: 'text-sm py-2 px-3.5 gap-2 min-h-[48px]',
  md: 'text-base py-2.5 px-4 gap-2 min-h-[48px]',
  lg: 'text-base py-3 px-5 gap-2 min-h-[48px]',
};

const classes = [
  baseStyles,
  variants[variant],
  sizes[size],
  fullWidth ? 'w-full' : '',
  className,
].filter(Boolean).join(' ');
---

{
  href ? (
    <a
      href={href}
      target={target}
      rel={target === '_blank' ? (rel || 'noopener noreferrer') : rel}
      class={classes}
      id={id}
      {...rest}
    >
      <slot />
    </a>
  ) : (
    <button
      type={type}
      class={classes}
      id={id}
      {...rest}
    >
      <slot />
    </button>
  )
}
