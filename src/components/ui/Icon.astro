---
import iconsData from '@iconify-json/ph/icons.json';

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className = '' } = Astro.props;

// Normaliza o nome para o formato do Phosphor no Iconify (ex: 'whatsapp-logo', 'sparkle-light')
const iconName = name.startsWith('ph:') ? name.replace('ph:', '') : name;
const icon = (iconsData.icons as Record<string, { body: string; width?: number; height?: number }>)[iconName];

const width = icon?.width || iconsData.width || 256;
const height = icon?.height || iconsData.height || 256;
const body = icon?.body || '';
---

{
  body ? (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox={`0 0 ${width} ${height}`}
      width={size}
      height={size}
      class={`inline-block fill-current shrink-0 ${className}`}
      aria-hidden="true"
      set:html={body}
    />
  ) : (
    <span class={`inline-block w-[${size}px] h-[${size}px] ${className}`} />
  )
}
