---
import Icon from './ui/Icon.astro';
import { site } from '../config/site';

const pillarIcons = [
  'flask-light',
  'sparkle-light',
  'clock-light',
];
---

<section class="bg-sand/20 py-16 sm:py-20 border-b hairline">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {site.pillars.map((pillar, index) => (
        <div class="bg-white rounded-xl p-6 border hairline shadow-sm flex flex-col justify-between transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-1">
          <div>
            <div class="w-12 h-12 rounded-lg bg-ink text-champagne flex items-center justify-center mb-4">
              <Icon name={pillarIcons[index] || 'sparkle-light'} size={24} />
            </div>
            <h3 class="font-serif text-2xl font-medium tracking-tight text-ink mb-2">
              {pillar.title}
            </h3>
            <p class="font-sans text-sm leading-relaxed text-olive text-pretty">
              {pillar.description}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t hairline flex items-center justify-between text-xs font-sans text-olive font-medium uppercase tracking-wider">
            <span>Pilar {index + 1}</span>
            <span class="text-champagne font-serif text-sm">✦</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
