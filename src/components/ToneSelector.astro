---
import { tonePicks, periodPicks, defaultTone, defaultPeriod, selectionLink } from '../lib/tones';

interface Props {
  idPrefix?: string;
  ctaText?: string;
  hintText?: string;
}

const {
  idPrefix = 'sel',
  ctaText = 'Consultar disponibilidade no WhatsApp',
  hintText = 'Sem cadastro e sem formulário. Atendimento direto com a equipe técnica.',
} = Astro.props;
const initialLink = selectionLink(defaultTone, defaultPeriod);
---

<div class="sel">
  <fieldset>
    <legend>Escolha o seu tom ou objetivo</legend>
    <div class="tones" role="radiogroup" aria-label="Escala de tons">
      {tonePicks.map((t) => (
        <label class="tone">
          <input
            type="radio"
            name={`${idPrefix}-tone`}
            value={t.id}
            checked={t.id === defaultTone}
            aria-label={`${t.label} (nível ${t.numeral})`}
          />
          <div class="tone__sw" style={`--sw: ${t.swatch};`}></div>
          <span class="tone__lb">{t.label}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <fieldset>
    <legend>Período de preferência</legend>
    <div class="periods" role="radiogroup" aria-label="Período de preferência">
      {periodPicks.map((p) => (
        <label class="period">
          <input
            type="radio"
            name={`${idPrefix}-period`}
            value={p.id}
            checked={p.id === defaultPeriod}
            aria-label={p.label}
          />
          <span>{p.label}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <div class="sel__action">
    <a
      href={initialLink}
      class="btn btn--wa btn--block"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Abrir conversa no WhatsApp oficial para consultar disponibilidade"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
      </svg>
      <span>{ctaText}</span>
    </a>
    <p class="sel__hint" style="margin-top: 8px; text-align: center;">
      {hintText}
    </p>
  </div>
</div>
