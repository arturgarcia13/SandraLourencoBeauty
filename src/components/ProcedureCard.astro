---
import MediaPlaceholder from './ui/MediaPlaceholder.astro';
import Badge from './ui/Badge.astro';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
import { waLink } from '../lib/whatsapp';

interface Props {
  title: string;
  headline: string;
  description: string;
  priceDisplay: string;
  durationDisplay: string;
  badges: readonly string[] | string[];
  waMessage: string;
  accent?: string;
}

const {
  title,
  headline,
  description,
  priceDisplay,
  durationDisplay,
  badges,
  waMessage,
} = Astro.props;

const directLink = waLink(waMessage);
---

<div class="bg-white rounded-2xl border hairline shadow-sm overflow-hidden flex flex-col justify-between transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:shadow-lg hover:border-sand-2">
  <div>
    <!-- Imagem vertical 4:5 -->
    <div class="p-2">
      <MediaPlaceholder
        aspectRatio="4/5"
        label={title}
        sublabel="Resultado autoral"
        dark={true}
        class="rounded-lg"
      />
    </div>

    <!-- Conteúdo textual do Card -->
    <div class="p-4 pt-2">
      <!-- Badges -->
      <div class="flex flex-wrap gap-1 mb-3">
        {badges.map((b) => (
          <Badge variant={b.includes('formol') || b.includes('gestantes') ? 'leaf' : 'gold'}>
            {b}
          </Badge>
        ))}
      </div>

      <!-- Título do Procedimento -->
      <h3 class="font-serif text-2xl font-medium tracking-tight text-ink mb-1">
        {title}
      </h3>

      <p class="text-xs font-sans font-semibold text-olive uppercase tracking-wider mb-2">
        {headline}
      </p>

      <p class="text-xs font-sans leading-relaxed text-olive mb-4 line-clamp-3 text-pretty">
        {description}
      </p>
    </div>
  </div>

  <!-- Rodapé com Tempo, Preço e Botão de Ação -->
  <div class="p-4 pt-0 border-t hairline mt-2">
    <div class="flex items-center justify-between text-xs font-sans py-3 mb-3">
      <div class="flex items-center gap-1.5 text-olive">
        <Icon name="clock-light" size={16} />
        <span>{durationDisplay}</span>
      </div>

      <div class="font-semibold text-ink text-right">
        {priceDisplay}
      </div>
    </div>

    <Button
      href={directLink}
      target="_blank"
      rel="noopener noreferrer"
      variant="wa"
      size="md"
      fullWidth={true}
      class="text-sm font-semibold"
    >
      <Icon name="whatsapp-logo" size={18} class="mr-1" />
      Consultar no WhatsApp
    </Button>
  </div>
</div>
