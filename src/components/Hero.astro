---
import MediaPlaceholder from './ui/MediaPlaceholder.astro';
import ProcedureSelector from './ProcedureSelector.astro';
import Icon from './ui/Icon.astro';
import { site } from '../config/site';
---

<section class="relative bg-ink text-ivory pt-28 pb-16 sm:pt-36 sm:pb-24 overflow-hidden border-b hairline-dark">
  <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Coluna de Conteúdo -->
      <div class="lg:col-span-7 flex flex-col items-center lg:items-start text-center lg:text-left">
        
        <!-- Badges de Prova e Autoridade -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2 mb-4">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-charcoal border border-white/10 text-xs font-sans text-ivory">
            <Icon name="star-fill" size={12} class="text-champagne" />
            <span class="font-semibold text-champagne">5.0</span>
            <span class="text-ivory/60">{site.rating.label}</span>
          </div>

          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-charcoal border border-white/10 text-xs font-sans text-champagne">
            <Icon name="map-pin-light" size={14} />
            <span>Bonsucesso em Fortaleza</span>
          </div>
        </div>

        <!-- Headline com Gradiente Branco para #9B9B9B (Regra B5 da skill) -->
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl leading-tight font-medium tracking-tight mb-4 max-w-[680px] text-balance">
          <span class="bg-gradient-to-r from-white to-[#9B9B9B] bg-clip-text text-transparent">
            Loiro saudável e alisamento seguro <br class="hidden sm:inline" />com padrão de excelência
          </span>
        </h1>

        <!-- Subtítulo com max width de 680px e quebras de linha com sentido -->
        <p class="font-sans text-sm sm:text-base leading-relaxed text-ivory/80 mb-6 max-w-[680px] font-normal text-pretty">
          Diagnóstico técnico individual, teste de mechas obrigatório e opção de alisamento livre de formol. Atendimento privativo com a assinatura Sandra Lourenço.
        </p>

        <!-- Seletor de Atendimento Contextualizado -->
        <div class="w-full max-w-xl">
          <ProcedureSelector id="hero-scheduler" dark={true} />
        </div>

        <!-- Indicadores de Risco Reverso e Conforto -->
        <div class="mt-4 flex flex-wrap items-center justify-center lg:justify-start gap-x-6 gap-y-2 text-xs text-ivory/80 font-sans">
          <span class="flex items-center gap-1.5">
            <Icon name="shield-check-light" size={14} class="text-wa" />
            Sem cadastros ou aplicativos externos
          </span>
          <span class="flex items-center gap-1.5">
            <Icon name="clock-light" size={14} class="text-champagne" />
            Ambiente exclusivo com hora marcada
          </span>
        </div>

      </div>

      <!-- Coluna Visual 4:5 -->
      <div class="lg:col-span-5 flex flex-col items-center">
        <div class="w-full max-w-sm lg:max-w-none relative">
          <div class="rounded-2xl border border-white/10 p-2 bg-charcoal">
            <MediaPlaceholder
              aspectRatio="4/5"
              label="Sandra Lourenço Beauty"
              sublabel="Especialista em mechas e alisamento"
              dark={true}
              class="rounded-lg"
            />
          </div>

          <!-- Tag Flutuante de Credibilidade -->
          <div class="absolute -bottom-3 -left-2 sm:-left-4 bg-charcoal border border-white/10 rounded-lg p-3 shadow-xl max-w-[220px]">
            <p class="text-xs font-sans font-semibold text-champagne uppercase tracking-wider">
              Critério técnico
            </p>
            <p class="text-xs font-sans text-ivory/80 mt-1 leading-snug">
              Preservação total da fibra capilar em cada procedimento.
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
