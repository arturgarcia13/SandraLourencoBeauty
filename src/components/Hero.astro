---
import ToneSelector from './ToneSelector.astro';
import Media from './Media.astro';
import { getImage } from '../lib/media';

const hasHeroPhoto = Boolean(getImage('hero'));
---

<section
  class="sec hero"
  data-tone="1"
  data-tone-label="Nível 1 · Carvão"
  style="--sbg: #121010; --sink: #F6EFE6;"
  id="inicio"
>
  <div class="wrap">
    <div class="grid hero__grid">
      <div class="hero__copy">
        <div class="eyebrow" data-reveal="up" data-intro>
          Salão boutique em Fortaleza · Bonsucesso
        </div>

        <h1 data-split="lines" data-intro>
          Loiros saudáveis, morena iluminada e alisamento sem formol
        </h1>

        <p class="hero__sub" data-reveal="up" data-delay="0.1" data-intro>
          Atendimento privativo com hora marcada, teste de mechas obrigatório e critério técnico para a saúde dos fios.
        </p>

        <div data-reveal="up" data-delay="0.2" data-intro>
          <ToneSelector idPrefix="hero" ctaText="Consultar disponibilidade no WhatsApp" />
        </div>
      </div>

      <div class="hero__poster" data-reveal="scale" data-intro>
        <div class={`poster ${hasHeroPhoto ? 'poster--photo' : ''}`} style="--p-bg: #C79A62; --p-ink: #171310;">
          {hasHeroPhoto ? (
            <Media name="hero" alt="Resultado de cabelo assinado por Sandra Lourenço" eager={true} />
          ) : null}

          <div class="poster__top">
            <div class="poster__brand">
              <span class="brand__logo brand__logo--sm" aria-hidden="true"></span>
              <span>Escala de cor</span>
            </div>
            <span>Sandra Lourenço</span>
          </div>

          <div class="poster__num" aria-hidden="true">
            7
          </div>

          <div class="poster__bottom">
            <span class="poster__name">Mel</span>
            <span class="muted" style="font-size: var(--t-xs);">Nível de clareamento</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
