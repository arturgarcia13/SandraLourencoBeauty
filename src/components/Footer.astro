---
import { site } from '../config/site';
---

<footer class="ftr" role="contentinfo" style="background: #121010; color: #F6EFE6;">
  <div class="wrap">
    <div class="ftr__grid">
      <div>
        <div class="ftr__brand">
          <span class="brand__logo brand__logo--lg" aria-hidden="true"></span>
          <span>{site.name}</span>
        </div>
        <p style="max-width: 38ch; margin-bottom: var(--s4);" class="muted">
          Cosmetologia e estética capilar de alto padrão. Especialista em loiros saudáveis, morena iluminada e alisamento orgânico.
        </p>
        <p class="muted">
          CNPJ {site.cnpj}
        </p>
      </div>

      <div>
        <b>Atendimento</b>
        <p>{site.hours.display}</p>
        <p class="muted" style="margin-top: 4px;">{site.hours.frequency}</p>
        <p style="margin-top: var(--s4);">
          <a href={site.instagram} target="_blank" rel="noopener noreferrer" aria-label="Abrir Instagram oficial de Sandra Lourenço">
            {site.instagramHandle}
          </a>
        </p>
        <p style="margin-top: 4px;">
          WhatsApp: {site.whatsapp.formatted}
        </p>
      </div>

      <div>
        <b>Espaço</b>
        <address style="font-style: normal;">
          <p>{site.address.street}</p>
          <p>{site.address.district} · {site.address.city}, {site.address.state}</p>
          <p class="muted">CEP {site.address.zip}</p>
        </address>

        <div style="margin-top: var(--s5); display: flex; flex-direction: column; gap: 4px;">
          <a href="/privacidade">Política de privacidade</a>
          <a href="/termos">Termos de atendimento</a>
        </div>
      </div>
    </div>

    <div style="margin-top: var(--s8); padding-top: var(--s5); border-top: 1px solid rgba(246, 239, 230, 0.1); display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s4); font-size: var(--t-xs);">
      <span>© {new Date().getFullYear()} {site.name}. Todos os direitos reservados.</span>
      <span>Fortaleza, Ceará</span>
    </div>
  </div>
</footer>
