---
import SectionHeading from './ui/SectionHeading.astro';
import ProcedureCard from './ProcedureCard.astro';
import { site } from '../config/site';
---

<section id="procedimentos" class="py-16 sm:py-24 bg-ivory border-b hairline">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <SectionHeading
      eyebrow="Especialidades em destaque"
      title="Assinatura técnica e cuidados exclusivos"
      description="Cada procedimento é executado respeitando rigorosos critérios de biossegurança, teste prévio da fibra capilar e produtos de alto padrão."
      align="center"
      class="mb-12 sm:mb-16"
    />

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {site.featured.map((item) => (
        <ProcedureCard
          title={item.title}
          headline={item.headline}
          description={item.description}
          priceDisplay={item.priceDisplay}
          durationDisplay={item.durationDisplay}
          badges={item.badges}
          waMessage={item.waMessage}
          accent={item.accent}
        />
      ))}
    </div>

    <!-- Mensagem de transparência sobre preços -->
    <div class="mt-10 text-center">
      <p class="text-xs font-sans text-olive/80 max-w-xl mx-auto">
        * Os valores são referências baseadas em comprimento e histórico dos fios. O orçamento exato é firmado presencialmente após avaliação diagnóstica.
      </p>
    </div>
  </div>
</section>
