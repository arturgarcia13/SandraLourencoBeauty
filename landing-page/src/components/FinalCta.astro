---
import { site } from '../config/site';
import { waLink } from '../lib/whatsapp';

const finalWaLink = waLink('Gostaria de agendar um atendimento.');
---

<section class="sec sec--deep fin" id="agendar">
  <div class="wrap">
    <h2 class="h-xl" data-split="words">Vamos descobrir o seu tom?</h2>

    <p class="lead muted" data-reveal="up" style="max-width: 48ch;">
      Atendimento privativo com hora marcada. Envie uma mensagem e a equipe verifica as datas disponíveis para você.
    </p>

    <div class="fin__actions" data-reveal="up" style="margin-top: var(--s6);">
      <a
        href={finalWaLink}
        class="btn btn--brand"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Agendar atendimento pelo WhatsApp"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
        </svg>
        <span>Agendar pelo WhatsApp</span>
      </a>
    </div>

    <div class="fin__trust" data-reveal="up" style="margin-top: var(--s6);">
      <span>{site.hours.display}</span>
      <span>{site.address.district} · {site.address.city}, {site.address.state}</span>
    </div>
  </div>
</section>
