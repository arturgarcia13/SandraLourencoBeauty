---
import Media from './Media.astro';
import { getImage } from '../lib/media';
import { site } from '../config/site';
import { waLink } from '../lib/whatsapp';

const heroPhotos = ['foto1', 'foto2', 'foto3', 'foto4'].filter((name) => Boolean(getImage(name)));
const hasPhotos = heroPhotos.length > 0;
const heroWaLink = waLink('Gostaria de agendar um atendimento.');
---

<section class="sec sec--base hero" id="inicio">
  <div class="wrap">
    <div class="grid hero__grid">
      <div class="hero__copy">
        <p class="hero__eyebrow" data-reveal="up" data-intro>Salão boutique · Fortaleza</p>

        <h1 data-split="lines" data-intro>
          Loiros luminosos, sem abrir mão da saúde do fio
        </h1>

        <p class="hero__sub" data-reveal="up" data-delay="0.1" data-intro>
          Atendimento privativo com hora marcada e teste de mechas obrigatório. Morena iluminada e alisamento sem formol com critério técnico.
        </p>

        <div class="hero__actions" data-reveal="up" data-delay="0.2" data-intro>
          <a
            href={heroWaLink}
            class="btn btn--accent"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Agendar atendimento pelo WhatsApp"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
            </svg>
            <span>Agendar pelo WhatsApp</span>
          </a>
          <a href="#servicos" class="btn btn--line">
            <span>Ver serviços</span>
          </a>
        </div>

        <div class="hero__trust" data-reveal="up" data-delay="0.3" data-intro>
          <span><b>{site.rating.value}</b> · {site.rating.count} avaliações no Avec VIP</span>
          <span>{site.hours.display}</span>
        </div>
      </div>

      <div class="hero__poster" data-reveal="scale" data-intro>
        <div class={`poster ${hasPhotos ? 'poster--photo' : ''}`} style="--p-bg: var(--bg-deep); --p-ink: var(--on-deep);">
          {hasPhotos ? (
            <div class="hero-carousel" data-hero-carousel>
              <div
                class="hero-carousel__slides"
                role="region"
                aria-roledescription="carrossel de fotos"
                aria-label="Destaques de transformações capilares"
              >
                {heroPhotos.map((photoName, idx) => (
                  <div
                    class={`hero-carousel__slide ${idx === 0 ? 'is-active' : ''}`}
                    data-slide-index={idx}
                    role="group"
                    aria-roledescription="slide"
                    aria-label={`Foto ${idx + 1} de ${heroPhotos.length}`}
                    aria-hidden={idx !== 0 ? 'true' : 'false'}
                  >
                    <Media
                      name={photoName}
                      alt={`Transformação capilar assinada por Sandra Lourenço - foto ${idx + 1}`}
                      eager={idx === 0}
                    />
                  </div>
                ))}
              </div>

              {heroPhotos.length > 1 && (
                <div class="hero-carousel__ui" aria-label="Navegação de fotos">
                  <div class="hero-carousel__bars" role="tablist" aria-label="Selecionar foto">
                    {heroPhotos.map((_, idx) => (
                      <button
                        type="button"
                        class={`hero-carousel__bar ${idx === 0 ? 'is-active' : ''}`}
                        data-index={idx}
                        role="tab"
                        aria-selected={idx === 0 ? 'true' : 'false'}
                        aria-label={`Ir para foto ${idx + 1} de ${heroPhotos.length}`}
                      >
                        <span class="hero-carousel__progress" aria-hidden="true" />
                      </button>
                    ))}
                  </div>

                  <div class="hero-carousel__meta">
                    <button
                      type="button"
                      class="hero-carousel__toggle"
                      data-carousel-toggle
                      aria-pressed="false"
                      aria-label="Pausar apresentação automática"
                    >
                      <svg class="ic-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <rect x="6" y="5" width="4" height="14" rx="1" />
                        <rect x="14" y="5" width="4" height="14" rx="1" />
                      </svg>
                      <svg class="ic-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M8 5.5v13l11-6.5z" />
                      </svg>
                    </button>
                    <span class="hero-carousel__count" aria-hidden="true">
                      <span data-carousel-current>01</span> / 0{heroPhotos.length}
                    </span>
                  </div>
                </div>
              )}
            </div>
          ) : (
            <>
              <div class="poster__top">
                <div class="poster__brand">
                  <span class="brand__logo brand__logo--sm" aria-hidden="true"></span>
                  <span>Beauty</span>
                </div>
                <span>Fortaleza</span>
              </div>

              <div class="poster__num" aria-hidden="true">
                SL
              </div>

              <div class="poster__bottom">
                <span class="poster__name">Loiros &amp; alinhamento</span>
                <span class="muted" style="font-size: var(--t-xs);">sob medida</span>
              </div>
            </>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
